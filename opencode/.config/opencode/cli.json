{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "catppuccin"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "auto",
    "scrollbar": true,
    "thinking": "show",
    "grouping": "none"
  },
  "animations": true,
  "plugins": [
    "./plugins/tui-clock",
    "./herdr-opencode"
  ],
  "keybinds": {
    "prompt.queue": "return"
  }
}
