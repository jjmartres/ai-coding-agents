{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex/gemini-3.8-flash",
  "default_agent": "devops-engineer",
  "agents": {
    "title": {
      "model": "google-vertex/gemini-3.8-flash"
    },
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      {
        "action": "provider.use",
        "resource": "google-vertex",
        "effect": "allow",
      },
      { "action": "provider.use", "resource": "openrouter", "effect": "allow" },
      { "action": "provider.use", "resource": "calculon", "effect": "allow" },
    ],
  },
  "providers": {
    "google-vertex": {
      "settings": {
        "project": "{env:VERTEXAI_PROJECT_ID}",
        "location": "{env:VERTEXAI_REGION}",
      },
      "models": {
        "gemini-3.8-flash": {},
        "gemini-3.5-flash": {},
        "gemini-3.1-pro-preview": {},
      },
    },
    "calculon": {
      "name": "calculon",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://calculon.local:8000/v1",
        "apiKey": "{env:OMLX_API_KEY}",
      },
      "models": {
        "Qwen3.5-9B-MLX-4bit": {
          "name": "Qwen3.5-9B-MLX-4bit",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
        "gemma-4-e4b-it-8bit": {
          "name": "gemma-4-e4b-it-8bit",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 20000,
    },
    "buffer": 32000,
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 32768,
  },
  "update": "auto",
  "instructions": ["~/.ai-agents/rules/*.md"],
  "share": "disabled",
  "plugins": [
    "@tarquinen/opencode-dcp@latest",
    "./plugins/session-namer"
  ],
  "mcp": {
    "servers": {
      "nibbler": {
        "type": "remote",
        "url": "{env:NIBBLER__MCP_URL}",
        "headers": {
          "Authorization": "Bearer {env:NIBBLER__MCP_TOKEN}",
        },
        "disabled": true,
      },
      "oskar": {
        "type": "remote",
        "url": "{env:OSKAR__MCP_URL}",
        "oauth": {
          "client_id": "{env:OSKAR__MCP_CLIENT_ID}",
        },
        "disabled": true,
      },
    },
  },
}
