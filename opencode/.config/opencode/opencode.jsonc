{
  "$schema": "https://opencode.ai/config.json",
  "model": "google-vertex/gemini-3.8-flash",
  "default_agent": "devops-engineer",
  "agents": {
    "title": {
      "model": "google-vertex/gemini-3.8-flash",
    },
  },
  "experimental": {
    "policies": [
      { "action": "provider.use", "resource": "*", "effect": "deny" },
      {
        "action": "provider.use",
        "resource": "google-vertex",
        "effect": "allow",
      },
      { "action": "provider.use", "resource": "openrouter", "effect": "allow" },
      { "action": "provider.use", "resource": "calculon", "effect": "allow" },
    ],
  },
  "providers": {
    "google-vertex": {
      "settings": {
        "project": "{env:VERTEXAI_PROJECT_ID}",
        "location": "{env:VERTEXAI_REGION}",
      },
      "models": {
        "gemini-3.8-flash": {
          "cost": [
            {
              "input": 0.75,
              "output": 3.75,
              "cache": {
                "read": 0.075,
                "write": 0,
              },
            },
          ],
        },
        "gemini-3.5-flash": {
          "cost": [
            {
              "input": 1.5,
              "output": 9,
              "cache": {
                "read": 0.15,
                "write": 0,
              },
            },
          ],
        },
        "gemini-3.1-pro-preview": {
          "cost": [
            {
              "input": 2,
              "output": 12,
              "cache": {
                "read": 0.2,
                "write": 0,
              },
            },
            {
              "tier": {
                "type": "context",
                "size": 200000,
              },
              "input": 4,
              "output": 18,
              "cache": {
                "read": 0.4,
                "write": 0,
              },
            },
          ],
        },
      },
    },
    "calculon": {
      "name": "calculon",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://calculon.local:8000/v1",
        "apiKey": "{env:OMLX_API_KEY}",
      },
      "models": {
        "Qwen2.5-Coder-14B-Instruct-4bit": {
          "name": "Qwen2.5-Coder-14B-Instruct-4bit",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"],
          },
        },
      },
    },
  },
  "compaction": {
    "auto": true,
    "keep": {
      "tokens": 15000,
    },
    "buffer": 20000,
  },
  "tool_output": {
    "max_lines": 800,
    "max_bytes": 32768,
  },
  "update": "auto",
  "instructions": ["~/.ai-agents/rules/*.md"],
  "share": "disabled",
  "plugins": ["./plugins/session-namer"],
  "mcp": {
    "servers": {
      "nibbler": {
        "type": "remote",
        "url": "{env:NIBBLER__MCP_URL}",
        "headers": {
          "Authorization": "Bearer {env:NIBBLER__MCP_TOKEN}",
        },
        "disabled": false,
      },
      "oskar": {
        "type": "remote",
        "url": "{env:OSKAR__MCP_URL}",
        "oauth": {
          "client_id": "{env:OSKAR__MCP_CLIENT_ID}",
        },
        "disabled": true,
      },
    },
  },
}
